# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/nipms

# API
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security — replace JWT_SECRET before any shared / production deployment
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Used only by `npm run seed` to bootstrap initial accounts (min 10 characters)
BOOTSTRAP_PASSWORD=ChangeMeSecurely1

# ---------------------------------------------------------------------------
# Object storage
# local = server/uploads (default, no Docker needed)
# s3    = MinIO / AWS S3 (recommended for ministry and multi-server setups)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local

# MinIO / S3 settings (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nipms-documents
S3_FORCE_PATH_STYLE=true

# Public URL used in email verification / password-reset links
APP_URL=http://localhost:5173

# Email — leave SMTP_* empty for local console delivery (links printed in API logs)
MAIL_FROM_NAME=NIPMS
MAIL_FROM_ADDRESS=noreply@nipms.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
