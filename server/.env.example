# Copy to server/.env and fill in. Use the SAME Atlas URI, JWT secret,
# bootstrap password, and SMTP values locally and on Render.

# ---------------------------------------------------------------------------
# Database — local Mongo OR Atlas. Point this at Atlas before seeding
# so local and production share the same data (and the same uploaded files).
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/nipms
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nipms?retryWrites=true&w=majority

# API
PORT=3001
NODE_ENV=development

# CORS_ORIGINS and APP_URL are optional.
# Localhost is always allowed. On Render, RENDER_EXTERNAL_URL is picked up automatically.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# APP_URL=http://localhost:5173

# Security — use the same JWT_SECRET locally and on Render
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Used by `npm run seed` (min 10 characters, upper, lower, number)
BOOTSTRAP_PASSWORD=ChangeMeSecurely1
# FORCE_SEED=true

# ---------------------------------------------------------------------------
# Email — same SMTP locally and on Render (Gmail App Password, Brevo, etc.)
# Leave SMTP_HOST empty to print links in the API console instead of sending.
# ---------------------------------------------------------------------------
MAIL_FROM_NAME=NIPMS
MAIL_FROM_ADDRESS=noreply@nipms.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
